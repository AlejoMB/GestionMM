@model IEnumerable<Domain.Entities.Facturacion.FacturaDetalle>

@{
    ViewData["Title"] = "Detalle Factura";
}

<h1>Detalle Factura</h1>

<p>
    <a asp-action="Create" asp-route-id="@Model.FirstOrDefault()?.Encabezado?.Id">Adicionar Media</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Media</th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioUnitario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Total)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.Media.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrecioUnitario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cantidad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Total)
            </td>
            <td>
                <a asp-action="Index" asp-controller="FactuEnc" asp-route-id="@item.Encabezado.Id">Encabezado</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a> |
                
            </td>
        </tr>
}
    </tbody>
</table>
