@{
}
@model FacturaEncModel
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fork-awesome@1.2.0/css/fork-awesome.min.css" integrity="sha256-XoaMnoYC5TH6/+ihMEnospgm0J1PM/nioxbOUdnM8HY=" crossorigin="anonymous">
<link rel="stylesheet" href="~/css/ModalPopUp.css" />
<link rel="stylesheet" href="~/css/Compras.css" />
<link rel="stylesheet" href="~/css/Inventario.css" />

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">Factura</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <strong>ID:</strong>
                        </div>
                        <div class="col-md-1">
                            <input class="form-control" id="FactuId" type="text" disabled placeholder="Id" aria-label=".form-control-sm example">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <strong>Cliente:</strong>
                        </div>
                        <div class="col-md-3">
                            <input type="hidden" id="hdnCliente" />
                            <input class="form-control" id="txtCliente" type="text" placeholder="Celular" aria-label=".form-control-sm example">

                        </div>
                        <div class="col-md-3">
                            <input class="form-control" id="txtCleinteName" disabled type="text" placeholder="Nombre" aria-label=".form-control-sm example">

                        </div>
                        <div class="col-md-3">
                            <input class="form-control" id="txtCleinteDir" type="text" placeholder="Direccion" aria-label=".form-control-sm example">

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <strong>Tipo Envío:</strong>
                        </div>
                        <div class="col-md-3">
                            <select asp-for="TipoEnvioId" class="form-select" id="tipoEnvio"
                                    asp-items="@ViewBag.TiposEnvios">
                                <option value="">-Tipo Envio-</option>
                            </select>
                        </div>
                    </div>
                    <div class="row" hidden id="divTransport">
                        <div class="col-md-3">
                            <strong>Transportadora:</strong>
                        </div>
                        <div class="col-md-3">
                            <select asp-for="TransportadoraId" class="form-select" id="transportadora"
                                    asp-items="@ViewBag.Transportadora">
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <strong>Medio de Pago:</strong>
                        </div>
                        <div class="col-md-3">
                            <select asp-for="MedioPagoId" class="form-select" id="medioPago"
                                    asp-items="@ViewBag.MedioPago">
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <strong>Fecha de Pago:</strong>
                        </div>
                        <div class="col-md-2">
                            <input id="fechaPago" class="form-control datepicker" type="text" placeholder="Fecha Pago" aria-label=".form-control-sm example">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <strong>Pagado:</strong>
                        </div>
                        <div class="col-md-1">
                            <select id="Estado" class="form-control" aria-label=".form-control-sm example">
                                <option value="1">Si</option>
                                <option value="2">No</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <strong>Total:</strong>
                        </div>
                        <div class="col-md-2">
                            <input id="TotalEnc" class="form-control currencyInput" disabled type="text" placeholder="$" aria-label=".form-control-sm example">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">Detalle Factura</div>
                <div class="card-body card-body-centered">
                    <div>
                        
                        <table id="DetalleFactuTb" class="table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Media</th>
                                    <th>Nombre</th>
                                    <th>Exist.</th>
                                    <th>Costo Compra</th>
                                    <th>Cant.</th>
                                    <th>Costo Venta</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="bodyFactura">
                                <tr class="row-to-clone">
                                    <td class="col-md-1">
                                        <a href="#" id="search_1" data-bs-toggle="modal" data-bs-target="#mediasModal" onclick="setId(this);">
                                            <img src="~/Img/Icons/search.png" width="30px" height="30px" />
                                        </a>
                                    </td>
                                    <td class="col-md-1">
                                        <input id="txtCodigo_1" class="form-control fontSmall codigoMedia" onblur="setId(this); SetMediaName(this);" type="text" aria-label=".form-control-sm example">
                                        <input type="hidden" id="txtPromo_1" class="promo" />
                                    </td>
                                    <td class="col-md-1">
                                        <input id="txtName_1" class="form-control fontSmall" type="text" disabled aria-label=".form-control-sm example">
                                    </td>
                                    <td class="col-md-1">
                                        <input id="txtExist_1" class="form-control fontSmall" type="text" disabled aria-label=".form-control-sm example">
                                    </td>
                                    <td class="col-md-1">
                                        <input id="txtCosto_1" class="form-control currencyInput  costo fontSmall" disabled type="text" aria-label=".form-control-sm example">
                                    </td>
                                    <td class="col-md-1">
                                        <input id="txtCant_1" class="form-control cantidad fontSmall" type="text" aria-label=".form-control-sm example">
                                    </td>
                                    <td class="col-md-1">
                                        <input id="txtVenta_1" class="form-control currencyInput  venta fontSmall" disabled type="text" aria-label=".form-control-sm example">
                                    </td>
                                    <td class="col-md-1">
                                        <input id="txtTotal_1" class="form-control total fontSmall text-center" style="padding-right: 0; padding-left: 0;" type="text" disabled aria-label=".form-control-sm example">
                                    </td>
                                    <td class="col-md-1 plusCol">
                                        <a href="#" id="add_1">
                                            <img src="~/Img/Icons/plus.png" width="30px" height="30px" class="add-row" />
                                        </a>
                                        <a href="#" id="delete_1">
                                            <img src="~/Img/Icons/delete.png" width="30px" height="30px" class="delete-row" />
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <input id="btnGuardar" type="button" class="btn btn-success" value="Guardar" onclick="CrearFactura()">
                        <input id="btnVerFactura" type="button" class="btn btn-info" value="Ver Factura" disabled>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="RowId" data-value="" />
<input type="hidden" id="UlrHost" data-value="@ViewBag.UlrHost" />
<input type="hidden" id="Descuentos" value="@ViewBag.Descuentos" />

<!-- Modal Cliente-->
<div class="modal fade" id="ClienteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Crear Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="lblCedula" class="form-label">Cedula</label>
                    <input class="form-control" id="mdlCedula">
                    <label for="lblCedula" class="form-label">Nombre</label>
                    <input class="form-control" id="mdlNombre">
                    <label for="lblCedula" class="form-label">Correo</label>
                    <input class="form-control" id="mdlCorreo">
                    <label for="lblCedula" class="form-label">Celular</label>
                    <input class="form-control" id="mdlCelular">
                    <label for="lblDireccion" class="form-label">Direccion</label>
                    <input class="form-control" id="mdlDireccion">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="crearCliente()">Guardar Cliente</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Buscador Medias-->
<div class="modal fade" id="mediasModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content" style="margin : 0% !important; width:100% !important">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Buscador Medias</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <partial name="~/Views/Shared/_BuscadorMedias.cshtml" />
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $(document).on("blur", "#txtCliente", buscarCliente);

        function calculateTotal() {

            var totalCantidad = 0;
            $('.cantidad').each(function () {
                var val = parseFloat($(this).val().replace("$", "").replace(/\./g, ''));
                if (!isNaN(val)) {
                    totalCantidad += val;
                }
            });

            /*var costo = parseInt($(this).closest("tr").find(".costo").val().replace("$", "").replace(".", ""));
            if (!isNaN(costo) && !isNaN(totalCantidad)) {
                var txtPromo = $(this).closest("tr").find(".promo").val();
                var esPromo = (txtPromo === 'True')
                if (esPromo) {
                    $(this).closest("tr").find(".venta").addClass("promoFactu");
                }
                else {
                    $(this).closest("tr").find(".venta").removeClass("promoFactu");
                }
                var ganancia = GetDescuento($(this).val(), esPromo);
                var cantidad = $(this).closest("tr").find(".cantidad").val();

                var porcentaje = 1 + (ganancia / 100);
                $(this).closest("tr").find(".venta").val(formatCurrency(calcularValorFinal(costo, porcentaje)));
                //$(this).closest("tr").find(".venta").val(formatCurrency(costo + ganancia));
                $(this).closest("tr").find(".venta").prop("title", "Ganancia: " + ganancia)
                var total = (costo + ganancia) * cantidad;
                $(this).closest("tr").find(".total").val(formatCurrency(total));
            }*/

            $('#DetalleFactuTb tbody tr').each(function () {
                
                var costo = parseFloat($(this).find(".costo").val().replace("$", "").replace(/\./g, ''));
                if (!isNaN(costo) && !isNaN(totalCantidad)) {
                    var txtPromo = $(this).find(".promo").val();
                    var esPromo = (txtPromo === 'True');
                    if (esPromo) {
                        $(this).find(".venta").addClass("promoFactu");
                    }
                    else {
                        $(this).find(".venta").removeClass("promoFactu");
                    }
                    var ganancia = parseFloat(GetDescuento(totalCantidad, esPromo));

                    var porcentaje = 1 + (ganancia / 100);
                    var valorRedondeado = calcularValorFinal(costo, porcentaje);
                    var incremento = (valorRedondeado - costo);
                    var cantidad = $(this).find(".cantidad").val();

                    $(this).find(".venta").val(formatCurrency(valorRedondeado));

                    $(this).find(".venta").prop("title", "Ganancia: " + incremento)
                    var total = valorRedondeado * cantidad;
                    $(this).find(".total").val(formatCurrency(total));
                }
            });
        }

        $(document).on('click', '.delete-row', function (event) {
            event.preventDefault(); // Prevent the default link behavior
            $(this).closest('tr').remove(); // Remove the closest <tr> element
        });

        $(document).on("blur", ".cantidad", calculateTotal);

        $("#tipoEnvio").on("change", function () {
            if ($(this).val() === '2') {
                $('#divTransport').attr("hidden", false);
                $("#medioPago").val('3');
            }
            else 
            {
                $('#divTransport').attr("hidden", true);
                $("#medioPago").val('1');
            }
            // Check input( $( this ).val() ) for validity here
        });

        $(document).on("click", ".add-row", function () {
            // Clone the row
            var newRow = $(".row-to-clone").clone();
            // Reset the values of input fields in the cloned row
            newRow.find('input[type="text"]').val('');
            // Generate a new suffix for IDs
            //var idSuffix = $(".row-to-clone").length + 1;
            var idSuffix = $('#DetalleFactuTb tr').length;
            // Update IDs of the cloned row elements
            newRow.find("[id]").each(function () {
                var oldId = $(this).attr("id");
                var newId = oldId.replace(/_\d+$/, "") + "_" + idSuffix;
                $(this).attr("id", newId);
            });
            // Remove class that makes it hidden
            newRow.removeClass("row-to-clone");
            newRow.find(".venta").removeClass("promoFactu");
            // Append the new row to the table body
            $("#bodyFactura tr:first").before(newRow);
            // Attach event listener for txtCant field in the new row
            newRow.find(".cantidad").on("blur", calculateTotal);

            newRow.find(".codigoMedia").focus();
            window.scrollTo(0, document.body.scrollHeight);
        });

        $(document).on("blur", ".venta", function () {
            var venta =  $(this).closest("tr").find(".venta").val().replace("$", "").replace(/\./g, '');
            var cantidad = $(this).closest("tr").find(".cantidad").val().replace("$", "").replace(/\./g, '');
            var total = parseInt(venta) * parseInt(cantidad);
            $(this).closest("tr").find(".total").val(formatCurrency(total));
        });
        
        $(document).on("blur", ".cantidad, .total, .venta", function () {
            var totalSum = 0;
            $('.total').each(function () {
                var val = parseFloat($(this).val().replace("$", "").replace(/\./g, ''));
                if (!isNaN(val)) {
                    totalSum += val;
                }
            });

            $("#TotalEnc").val(formatCurrency(totalSum));
        });

        $(document).on("blur", ".venta", function () {
            var txtId = this.id;
            var values = txtId.split("_");

            var cantidad = removeformatCurrency($("#txtCant_" + values[1]).val());

            var venta = removeformatCurrency($("#txtVenta_" + values[1]).val());

            var total = parseFloat(cantidad) * parseFloat(venta);

            $("#txtTotal_" + values[1]).val(formatCurrency(total));

        });



        $('#btnVerFactura').click(function () {
            var url = '@Url.Action("FactuPrint", "Facturacion")';
            var textValue = $('#FactuId').val();

            window.location.href = url + '?id=' + textValue;
        });
    });

    function GetDescuento(cantidad, esPromo) 
    {
        var listaDescuentos = $("#Descuentos").val()
        var rows = listaDescuentos.split("|");
        var descuento = 0;

        if (esPromo) {
            row = rows[rows.length - 1];
            var values = row.split(";");
            descuento = parseInt(values[2]);
        }
        else {
            if (rows.length > 0) {
                rows.forEach(function (row) {
                    var values = row.split(";");
                    if (values.length > 0) {
                        var min = parseInt(values[0]);
                        var max = parseInt(values[1]);
                        if (cantidad >= min && cantidad <= max) {
                            descuento = parseInt(values[2]);
                        }
                    }
                });
            }
        }

        return descuento;
    }

    function setId(row) {
        $("#RowId").val(row.id);
        console.log("Id: " + $("#RowId").val());
    }

    function buscarCliente()
    {
        if ($("#txtCliente").val() === '') {
            return false;
        }
        var cedCliente = $("#txtCliente").val();
        $.ajax({
            url: '/Facturacion/GetCliente',
            type: 'GET',
            data: { celular: cedCliente },
            success: function (data) {
                //console.log('Success');
                $("#hdnCliente").val(data.id);
                $("#txtCleinteName").val(data.nombre);
                $("#txtCleinteDir").val(data.direccion);

            },
            error: function (error) {
                limpiarCliente();
                $("#mdlCelular").val($("#txtCliente").val());
                $("#hdnCliente").val("");
                $("#txtCleinteName").val("");
                var modal = new bootstrap.Modal(document.getElementById('ClienteModal'), {})
                modal.show();
            }
        });

    }

    function crearCliente()
    {
        if (validarCLiente()) 
        {
            if (confirm("Desea Crear Cliente?") == true) {
                
                var formData = new FormData();
                formData.append('Cedula', $("#mdlCedula").val());
                formData.append('Nombre', $("#mdlNombre").val());
                formData.append('Correo', $("#mdlCorreo").val());
                formData.append('Celular', $("#mdlCelular").val());
                formData.append('Direccion', $("#mdlDireccion").val());

                $.ajax({
                    url: '/Facturacion/CrearCliente',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        $("#hdnCliente").val(data.id);
                        $("#txtCleinteName").val(data.nombre);
                        $("#txtCleinteDir").val(data.direccion);
                        limpiarCliente();
                        var myModalEl = document.getElementById('ClienteModal')
                        var modal = bootstrap.Modal.getInstance(myModalEl)
                        modal.hide();

                        
                    },
                    error: function (error) {
                        console.log(error.responseJSON.detail);
                    }
                });

            } else {
                text = "You canceled!";
            }
        }
    }

    function limpiarCliente() 
    { 
        $("#mdlCedula").val('');
        $("#mdlNombre").val('');
        $("#mdlCorreo").val('');
        $("#mdlCelular").val('');
    }

    function validarCLiente()
    {
        var isValid = true;
        isValid = validateInput("#mdlCedula");
        isValid = validateInput("#mdlNombre");
        isValid = validateInput("#mdlCorreo");
        isValid = validateInput("#mdlCelular");

        return isValid;
    }

    function BuscarMedias() {
        var TipoMediaId = $("#tipoMedia").find(":selected").val();;
        var TamanoId = $("#tamano").find(":selected").val();
        var MarcaId = $("#marca").find(":selected").val();
        var ColorId = $("#color").find(":selected").val();
        var DisenoId = $("#diseno").find(":selected").val();
        var SegmentoId = $("#segmento").find(":selected").val();
        var Name = $("#name").val();

        var formData = new FormData();
        formData.append('TipoMediaId', TipoMediaId);
        formData.append('TamanoId', TamanoId);
        formData.append('MarcaId', MarcaId);
        formData.append('ColorId', ColorId);
        formData.append('DisenoId', DisenoId);
        formData.append('SegmentoId', SegmentoId);
        formData.append('Name', Name);

        var coloresList = [];
        $('table.color-table tbody tr').each(function () {
            $(this).find('input[type="checkbox"]:checked').each(function () {
                coloresList.push($(this).attr('id'));
            });
        });

        coloresList.forEach(function (color) {
            formData.append('colores', color);
        });

        $.ajax({
            url: '/Compras/BuscarMedias',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                //console.log(data);
                var jsonResult = JSON.parse(data);
                var htmlString = "";
                $.each(jsonResult, function (index, media) {
                    htmlString = htmlString + "<div class='product'>" +
                        "<h7>" + media.TipoMediaText + " / " + media.TamanoText + " / " + media.MarcaText + " / " + media.DisenoText + " / " + media.SegmentoText + " </h7>" +
                        "<br />";
                    $.each(media.ColoresText, function (indexColor, color) {
                        var colorValues = color.split("_");
                        var rgbColor = colorValues[0].toString();
                        var nameColor = colorValues[1].toString();
                        htmlString = htmlString + "<span class='color-square' style='background-color: " + rgbColor + "' title='" + nameColor + "'>&ensp;&ensp;</span>";
                    });
                    var urlHost = $("#UlrHost").data("value");
                    htmlString = htmlString + "<a id='" + media.Id + "_" + media.Name + "_" + media.Existencia + "' href='#' onclick='SetImageId(this.id);'><img src='" + urlHost + media.Imagen + "' title='" + media.Name + "' /></a>" +
                        "<p>Cantidad: " + media.Existencia + " Unidades</p>" +
                        "</div>";
                });

                $("#productGallery").empty();
                $("#productGallery").append(htmlString);
            },
            error: function (error) {
                console.log(error.responseJSON.detail);
                $("#divError").show();

                var resultError = error.responseJSON.detail.split("_");

                $("#lblError").text(resultError[0]);
                var urlHost = $('#imgError').attr('src');
                $("#imgError").attr("src", urlHost + resultError[1]);


            }
        });
    }

    function SetImageId(linkId) {
        var rowId = $("#RowId").val();
        var result = rowId.split("_");
        var lknResult = linkId.split("_");

        $.ajax({
            url: '/Facturacion/GetCostoProrateo',
            type: 'GET',
            data: { idMedia: lknResult[0] },
            success: function (data) {

                if (data === 0) { 
                    
                    $("#txtName_" + result[1]).val("");
                    $("#txtName_" + result[1]).prop("title", "");
                    $("#txtExist_" + result[1]).val("");
                    $("#txtCosto_" + result[1]).val("");
                    alert("No Existen Compras para esta media");
                }
                else
                {
                    $("#txtCodigo_" + result[1]).val(lknResult[0]);
                    $("#txtName_" + result[1]).val(lknResult[1]);
                    $("#txtName_" + result[1]).prop("title", lknResult[1]);
                    $("#txtExist_" + result[1]).val(lknResult[2]);
                    $("#txtPromo_" + result[1]).val(lknResult[3]);
                    $("#txtCosto_" + result[1]).val(formatCurrency(data));
                }
                

            },
            error: function (error) {
                
            }
        });


        
        
        //getcostoProrateo

        var myModalEl = document.getElementById('mediasModal');
        var modal = bootstrap.Modal.getInstance(myModalEl);

        modal.hide();
    }

    function SetMediaName(inputCodigo) {

        var identificador = inputCodigo.id.toString();
        var result = identificador.split("_");
        var rowId = result[1];

        if ($.isNumeric($(inputCodigo).val()) && $(inputCodigo).val() !== '') {

            $.ajax({
                url: '/Facturacion/GetMediaName',
                type: 'GET',
                data: { codigoMedia: $(inputCodigo).val() },
                success: function (data) {
                    SetImageId(data);
                },
                error: function (error) {
                    $("#txtName_" + rowId).val("");
                    alert(error.responseText);
                }
            });
        }
        else {
            $("#txtName_" + rowId).val("");
        }

        $("#txtCant_" + rowId).val("");
        $("#txtVenta_" + rowId).val("");
        $("#txtVenta_" + rowId).removeClass("promoFactu");
        $("#txtTotal_" + rowId).val("");
    }

    function CrearFactura() { 
        if (validarFactura()) {

            var userId = localStorage.getItem('userId');

            // Encabezado
            var formData = new FormData();
            formData.append('Cliente', $("#txtCliente").val());
            formData.append('TipoEnvio', $("#tipoEnvio").val());
            formData.append('MedioPago', $("#medioPago").val());
            formData.append('FechaPago', $("#fechaPago").datepicker({ dateFormat: 'dd-mm-yy' }).val());
            formData.append('EstadoFactu', $("#Estado").val());
            formData.append('Total', removeformatCurrency($("#TotalEnc").val()));
            formData.append('UserId', userId);

            //Detalle
            var detalleData = [];
            var rows = $('#DetalleFactuTb tr').length;
            for (var i = 1; i <= rows - 1; i++) {
                var detalleItem = {
                    Media: $("#txtCodigo_" + i).val(),
                    PrecioUnitario: removeformatCurrency($("#txtVenta_" + i).val()),
                    Cantidad: $("#txtCant_" + i).val(),
                    Total: removeformatCurrency($("#txtTotal_" + i).val())
                };

                detalleData.push(detalleItem);
            }

            var detalleDataJson = JSON.stringify(detalleData);
            formData.append('DetalleString', detalleDataJson);

            $.ajax({
                url: '/Facturacion/CrearFactura',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) {
                    $("#FactuId").val(data);
                    $("#btnVerFactura").prop('disabled', false);
                    $("#btnGuardar").prop('disabled', true);
                    alert("Factura creada con exito");
                },
                error: function (error) {
                    console.log(error.responseJSON.detail);
                }
            });
        }

    }
    
    function validarFactura()
    {
        var isValid = true;

        if (isValid) isValid = validateInput("#txtCliente");

        if (isValid) isValid = validateInput("#txtCleinteName");

        if (isValid) isValid = validateInput("#tipoEnvio");
        
        if (isValid) isValid = validateInput("#fechaPago");

        var rows = $('#DetalleFactuTb tr').length;

        for (var i = 1; i <= rows - 1; i++) {

            if (isValid) isValid = validateInput("#txtCodigo_" + i);
            if (isValid) isValid = validateInput("#txtCant_" + i);

        }

        return isValid;

    }
</script>