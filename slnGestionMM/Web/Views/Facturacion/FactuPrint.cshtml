}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .invoice {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        background-color: #fff;
        border: 1px solid #ccc;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .invoice-header {
        margin-bottom: 20px;
    }

        .invoice-header h1 {
            font-size: 24px;
            margin-bottom: 10px;
        }

        .invoice-header p {
            margin: 5px 0;
        }

    .invoice-details th {
        background-color: #f2f2f2;
    }
</style>

<div class="invoice">
    <div class="invoice-header">
        <img src="~/img/LogoML.jpg" alt="Company Logo" style="max-width: 150px; margin-bottom: 10px;">
        <h1>Factura <span style="color:red">@Model.Id</span></h1>
        <p><strong>Cliente:</strong> @Model.Cliente.Nombre </p>
        <p><strong>Total:</strong> $@Model.Total</p>
        <p><strong>Estado:</strong> @Model.EstadoFactu.Name</p>
        <p><strong>Tipo Pago:</strong> @Model.MedioPago.Name</p>
        <p><strong>Tipo Envío:</strong> @Model.TipoEnvio.Name</p>
        @* <p><strong>Fecha de Pago:</strong> @Model.FechaCreado</p> *@
    </div>
    <table class="table table-bordered invoice-details">
        <thead>
            <tr>
                <th>Codigo Media</th>
                <th>Descripción</th>
                <th>Precio Unitario</th>
                <th>Cantidad</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.FacturaDetalle) {
            <tr>
                <td>@item.Media.Id</td>
                <td>@item.Media.Name</td>
                <td>@item.PrecioUnitario</td>
                <td>@item.Cantidad</td>
                <td>$@item.Total</td>
            </tr>
            }
        </tbody>
    </table>
    <div class="text-end">
        <p><strong>Total Factura:</strong> $@Model.Total</p>
    </div>
</div>