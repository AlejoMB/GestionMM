                            </tr>
                            @* <tr>
                                <td><label for="codigo2">50</label></td>
                                <td><label for="precio2">$5.000</label></td>
                                <td><input type="text" style="width:20%" id="cantidad2" class="form-control" placeholder="0" value="10"></td>
                                <td><label for="total2">$50.000</label></td>
                            </tr> *@
                            <!-- Add more rows as needed -->
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end"><strong>Total Factrura:</strong></td>
                                <td><strong><label id="totalFactu">$40.000</label></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="text-end mt-3">
                    <a href="#" class="btn btn-success" target="_blank" onclick="EnviarWA();return false;">
                        <i class="fab fa-whatsapp"></i> Enviar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script type="text/javascript">

        /*document.addEventListener("DOMContentLoaded", function () {
            let images = document.querySelectorAll('img');
            let observer = new IntersectionObserver(function (entries, observer) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        let img = entry.target;
                        img.src = img.src;
                        observer.unobserve(img);
                    }
                });
            });

            images.forEach(image => {
                observer.observe(image);
            });
        });
        */

        document.addEventListener("DOMContentLoaded", function () {
            const images = document.querySelectorAll('.image-container img');

            images.forEach(function (img) {
                img.addEventListener('load', function () {
                    img.style.display = 'block';
                    img.previousElementSibling.style.display = 'none';
                });
            });
        });

        $(document).ready(function () {
            prices();
            loadSessionCart();

            $('.page-item').hover(function () {
                $(this).css('cursor', 'pointer');
            });

            // Initialize the tooltip
            $('#richTooltip').tooltip();

            // Show tooltip on click, toggle it
            $('.popoverTrigger').popover({
                trigger: 'click', // Show on click
                placement: 'right', // Placement of the popover
                html: true, // Allow HTML content in the popover
                content: function () {
                    // Get the image URL from the input field
                    var imageUrl = $("#lblImage_" + this.id.split("_")[1]).text();
                    return "<img src='" + imageUrl + "' alt='Example Image' class='img-fluid'>";
                }
            });
            // Optional: Automatically hide other popovers when clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.popoverTrigger').length) {
                    $('.popoverTrigger').popover('hide');
                }
            });

            $(document).on('click', '.delete-row', function (event) {
                event.preventDefault(); // Prevent the default link behavior

                var codigoMedia = $(this).closest("tr").find(".codigo").text();
                deleteItemFromCart(codigoMedia);

                $(this).closest('tr').remove(); // Remove the closest <tr> element
            });
            
            //Funcionalidad para abrir y cerrar tabs automaticos
            const urlParams = new URLSearchParams(window.location.search);
            const selectedTab = urlParams.get('selectedTab');
            
            if (selectedTab !== null) {
                var params = selectedTab.split('-');

                

                if (params.length === 2) {
                    const h2Element = document.querySelector('#panelsStayOpen-heading-' + params[0]);
                    const divElement = document.querySelector('#panelsStayOpen-collapse-' + params[0]);

                    const visible = params[1];

                    var buttonElement = h2Element.querySelector('button');

                    if (visible === "false") {
                        buttonElement.classList.add('collapsed');
                        buttonElement.setAttribute('aria-expanded', 'false');

                        divElement.classList.remove('show');
                    }
                    else {
                        buttonElement.classList.remove('collapsed');
                        buttonElement.setAttribute('aria-expanded', 'true');

                        divElement.classList.add('show');
                    }
                }
                else if (params.length === 3 || params.length === 4)
                {
                    const h2ElementParent = document.querySelector('#panelsStayOpen-heading-' + params[0]);
                    const divElementParent = document.querySelector('#panelsStayOpen-collapse-' + params[0]);

                    const h2ElementChild = document.querySelector('#panelsStayOpen-heading-' + params[0] + '-' + params[1]);
                    const divElementChild = document.querySelector('#panelsStayOpen-collapse-' + params[0] + '-' + params[1]);

                    const visibleChild = params[2];

                    var buttonElementChild = h2ElementChild.querySelector('button');

                    if (visibleChild === "true") {
                        buttonElementChild.classList.add('collapsed');
                        buttonElementChild.setAttribute('aria-expanded', 'false');

                        divElementChild.classList.remove('show');
                    }
                    else {
                        buttonElementChild.classList.remove('collapsed');
                        buttonElementChild.setAttribute('aria-expanded', 'true');

                        divElementChild.classList.add('show');
                    }

                    var buttonElementParent = h2ElementParent.querySelector('button');

                    buttonElementParent.classList.remove('collapsed');
                    buttonElementParent.setAttribute('aria-expanded', 'true');

                    divElementParent.classList.add('show');
                }
                
            }
        });


        function loadTab(tabElement) {
            
            const ariaExpandedValue = tabElement.getAttribute('aria-expanded');
            console.log($('#cart-data').val());
            window.location.href = '@Url.Action("Index", "Inventario")?selectedTab=' + tabElement.id + '-' + ariaExpandedValue;
        }

        function loadPagination(page)
        {
            var queryString = window.location.search.split('-');
            if (queryString.length === 4) 
            {
                window.location.href = '@Url.Action("Index", "Inventario")' + queryString[0] + '-' + queryString[1] + '-' + queryString[2] + '-' + page;
            }
            else
            {
                window.location.href = '@Url.Action("Index", "Inventario")' + window.location.search + '-' + page;
            }

            
        }

        function loadSessionCart() {
            // Retrieve sessionStorage data
            const cartData = sessionStorage.getItem("cartData");
            if (cartData) {
                //console.log("Cart data:", JSON.parse(cartData));
                var cartDataParsed = JSON.parse(cartData);
                console.log(cartDataParsed);
                cartDataParsed.forEach(function (item) {
                    $(`#${item.id}-cantidad`).addClass("agregado");
                    $(`#${item.id}-cantidad`).val(item.quantity);
                });

            } else {
                console.log("No cart data available");
            }

            if (cartData != null && cartData.length > 0) {
                $(".floating-cart-button").attr("hidden", false);
                countCartIcon(cartDataParsed);
            } else {
                $(".floating-cart-button").attr("hidden", true);
            }
        }

        function saveSessionCart(idMedia, cantidad, precios, url, imagen)
        {
            var cart = [];
            //const hiddenInputs = document.querySelectorAll('.agregado');
            //se debe gestionar busqueda y actualizacion en la variable de sesison

            var cartData = sessionStorage.getItem("cartData");
            var cart = JSON.parse(cartData);

            updateCart(idMedia, cantidad, cart, precios, url, imagen);

            if (cartData != null && cartData.length === 0) {
                $(".floating-cart-button").attr("hidden", true);
            } else {
                $(".floating-cart-button").attr("hidden", false);
            }

            
        }

        // Function to add or update product in cart
        function updateCart(productId, quantity, cart, precios, url, imagen) {
            // Find the product in the cart by productId
            if (cart === null) {
                cart = [];
            }

            var product = cart.find(item => item.id === productId);

            if (product) {
                // If product exists in the cart, update the quantity
                product.quantity = quantity;
            } else {
                // If product doesn't exist, add it to the cart
                cart.push({ 
                    id: productId, 
                    quantity: quantity,
                    precios: precios,
                    urlImagen: url,
                    nombreImg: imagen
                });
            }

            countCartIcon(cart);
            @* let totalQuantity = cart.reduce((sum, item) => sum + parseInt(item.quantity), 0);
            const catCart = document.getElementById(`qantCart`);
            catCart.textContent = totalQuantity *@

            // Update the hidden input with the serialized cart data
            sessionStorage.setItem("cartData", JSON.stringify(cart));
        }

        function countCartIcon(cart) {
            let totalQuantity = cart.reduce((sum, item) => sum + parseInt(item.quantity), 0);
            const catCart = document.getElementById(`qantCart`);
            catCart.textContent = totalQuantity
        }

        function loadCart() {

            $('#tableCarrito').find('tr').not('.row-to-clone').remove();
            const cartData = sessionStorage.getItem("cartData");
            var cartDataParsed = JSON.parse(cartData);
            var cantTotal = 0
            cartDataParsed.forEach(function (item) {
                cantTotal += parseInt(item.quantity);
            });

            var indicePrecio = 0;
            if (cantTotal >= 6 && cantTotal <= 29) {
                indicePrecio = 0;
            }
            else if (cantTotal >= 30 && cantTotal <= 99) {
                indicePrecio = 1;
            }
            else if (cantTotal >= 100) {
                indicePrecio = 2;
            }


            var rowCont = 1;
            var totalFactu = 0;
            cartDataParsed.forEach(function (item) {
                
                //var newRow = $(".row-to-clone");

                //if (rowCont !== 1) {
                var newRow = $(".row-to-clone").clone();
                //}
                newRow = $('.row-to-clone').clone().removeAttr('style').removeClass('row-to-clone');

                // Reset the values of input fields in the cloned row
                newRow.find('input[type="text"]').val('');
                newRow.find('label').text('');

                // Update IDs of the cloned row elements
                newRow.find("[id]").each(function () {
                    var oldId = $(this).attr("id");
                    var newId = oldId.replace(/_\d+$/, "") + "_" + rowCont;
                    $(this).attr("id", newId);
                });

                //if (rowCont !== 1) {
                //    newRow.removeClass("row-to-clone");
                //}
                var arregloPrecio = item.precios.split('-');
                var precioParced = 0;
                newRow.find("#codigo_" + rowCont).text(item.id);

                //newRow.find("#nombre_" + rowCont).text(item.nombreImg);
                //$("#image_" + rowCont).attr("src", item.urlImagen);
                newRow.find("#lblImage_" + rowCont).text(item.urlImagen);
                //$("#imageName_" + rowCont).text(item.nombreImg)

                if (arregloPrecio !== null) {
                    precioParced = parseInt(removeformatCurrency(arregloPrecio[indicePrecio]));
                    newRow.find("#precio_" + rowCont).text(arregloPrecio[indicePrecio]);
                }
                newRow.find("#cant_" + rowCont).val(item.quantity);

                if (precioParced !== 0) {
                    totalFactu += precioParced * parseInt(item.quantity)
                    newRow.find("#total_" + rowCont).text(formatCurrency(precioParced * parseInt(item.quantity)));
                }

                var txtImagen = "";
                txtImagen = item.nombreImg;
                newRow.find('.popoverTrigger').text(txtImagen.substring(0, 12) + "...");
                newRow.find('.popoverTrigger').prop("title", txtImagen);

                newRow.find('.popoverTrigger').popover({
                    trigger: 'click', // Show on click
                    placement: 'right', // Placement of the popover
                    html: true, // Allow HTML content in the popover
                    content: function () {
                        // Get the image URL from the input field
                        var imageUrl = $("#lblImage_" + this.id.split("_")[1]).text();
                        return "<img src='" + item.urlImagen + "' alt='Example Image' class='img-fluid'>";
                    }
                });

                //if (rowCont !== 1) {
                    $("#tableCarrito tr:first").after(newRow);
                //}

                rowCont++;
            });

            $("#totalFactu").text(formatCurrency(totalFactu));

        }

        function prices() {
            // Obtener todos los elementos input con la clase valorHidden
            const hiddenInputs = document.querySelectorAll('.valorHidden');
            hiddenInputs.forEach(input => {
                
                if (input.value.trim() !== '') {
                    
                    const inputId = input.id;

                    // Substraer el sufijo del id antes del carácter "-"
                    const suffix = inputId.split('-')[0];

                    // Referenciar el span con id=sufijo-desc2
                    const desc1Span = document.getElementById(`${suffix}-desc1`);
                    const desc2Span = document.getElementById(`${suffix}-desc2`);
                    const desc3Span = document.getElementById(`${suffix}-desc3`);

                    // Si el span existe, setearle el valor del input
                    if (desc1Span) {
                        desc1Span.textContent = formatCurrency(calcularValorFinal(input.value, 1.30));
                    }

                    if (desc2Span) {
                        desc2Span.textContent = formatCurrency(calcularValorFinal(input.value, 1.15));
                    }

                    if (desc3Span) {
                        desc3Span.textContent = formatCurrency(calcularValorFinal(input.value, 1.10));
                    }
                }
            });
        }

        function agregarACarrito(btnAgregar)
        {
            const inputId = btnAgregar.id;
            // Substraer el sufijo del id antes del carácter "-"
            const suffix = inputId.split('-')[0];

            if (isNaN(parseInt($(`#${suffix}-cantidad`).val())) || parseInt($(`#${suffix}-cantidad`).val()) === 0) {
                return;
            }

            $(`#${suffix}-cantidad`).addClass("agregado");

            var precio1 = $(`#${suffix}-desc1`).text();
            var precio2 = $(`#${suffix}-desc2`).text();
            var precio3 = $(`#${suffix}-desc3`).text();

            var precios = precio1 + "-" + precio2 + "-" + precio3;

            var imagenUrl = $(`#${suffix}-imagen`).attr("src");
            var nombreImagen = $(`#${suffix}-imagen`).attr("alt");


            saveSessionCart(suffix, $(`#${suffix}-cantidad`).val(), precios, imagenUrl, nombreImagen);
            
        }

        function eliminarDeCarrito(btnEliminar) 
        {
            const inputId = btnEliminar.id;
            // Substraer el sufijo del id antes del carácter "-"
            const suffix = inputId.split('-')[0];

            $(`#${suffix}-cantidad`).removeClass("agregado");
            $(`#${suffix}-cantidad`).val('0');
            
            
            deleteItemFromCart(suffix);
        }

        function deleteItemFromCart(productId) {
            var cartData = sessionStorage.getItem("cartData");
            var cart = JSON.parse(cartData);

            const productIndex = cart.findIndex(item => item.id === productId);

            if (productIndex !== -1) {
                
                cart.splice(productIndex, 1);

                $(`#${productId}-cantidad`).removeClass("agregado");
                $(`#${productId}-cantidad`).val('0');
                // Update the hidden input with the serialized cart data
                sessionStorage.setItem("cartData", JSON.stringify(cart));
                countCartIcon(cart);
            }
        }

        function EnviarWA() {
            const cartData = sessionStorage.getItem("cartData");
            if (cartData) {
                var cart = JSON.parse(cartData);
                var telefono = "573183939997";
                let infoDinamica = cart.map(item => `${item.id}|${item.quantity}`).join(';');
                
                var url = "https://api.whatsapp.com/send?phone=" + telefono + "&text=" + encodeURIComponent(infoDinamica);
                
                console.log("URL generada:", url);
                

                // Evitar duplicar el llamado a window.open
                var win = window.open(url, '_blank');

                if (win) {
                    // Si la ventana se abre correctamente, evitar hacer nada más
                    return;
                    win.focus();
                } else {
                    // Si no se abre la ventana (bloqueada por el navegador), se puede hacer otra acción aquí
                    alert("Permite las ventanas emergentes para abrir WhatsApp");
                }
            }
        }

    </script>
}


