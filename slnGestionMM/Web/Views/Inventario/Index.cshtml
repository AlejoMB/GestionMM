                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody id="tableCarrito">
                            <tr class="row-to-clone" style="display:none">
                                <td><label id="codigo_0" class="codigo">163</label></td>
                                <td>
                                    
                                    <input type="text" id="imageUrl" class="imageUrl" value="" hidden>
                                    <p id="lblImage_1" style="display:none"></p>
                                    <!-- Anchor that triggers the popover -->
                                    <a href="#" id="popoverTrigger" class="popoverTrigger">Click to Show Image</a>
                                </td>
                                <td><label id="precio_1">$4.000</label></td>
