@using Domain.Entities.Inventario
@using Web.ViewModels
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<CatalogoModel>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/Inventario.css" />

<h1>Catalogo</h1>

<div class="floating-cart-button" hidden>
   
    <img src="~/imagenes/shopcart.png" class="cart-image" data-bs-toggle="modal" data-bs-target="#carritoModal" />
    
    @* <img src="cart-icon.png" alt="Cart" class="cart-image"> *@
</div>

<input type="hidden" id="cartData" name="cartData" value="@ViewBag.CartData">

<div class="accordion" id="accordionPanelsStayOpenExample">
@foreach (var categoria in Model)
{
    <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-heading-@categoria.IdCategoria">
                <button id="@categoria.IdCategoria" class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapse-@categoria.IdCategoria" aria-expanded="false" aria-controls="panelsStayOpen-collapse-@categoria.IdCategoria" onclick="loadTab(this)">
                @categoria.Name
            </button>
        </h2>
            <div id="panelsStayOpen-collapse-@categoria.IdCategoria" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-heading-@categoria.IdCategoria" data-bs-parent="#accordionPanelsStayOpenExample">
            <div class="accordion-body">
                @foreach(var tamano in categoria.Tamanos)
                {
                        @if (tamano.CantidadTamano/*Medias.Count*/ > 0)
                     {   
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="panelsStayOpen-heading-@categoria.IdCategoria-@tamano.Id">
                                    <button id="@categoria.IdCategoria-@tamano.Id" class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapse-@categoria.Name-@tamano.Name.Replace("/", "-").Replace(" ", "-").Replace("(", "-").Replace(")", "-")" aria-expanded="false" aria-controls="panelsStayOpen-collapse-@categoria.IdCategoria-@tamano.Id" onclick="loadTab(this)">
                                        @tamano.Name : @tamano.CantidadTamano
                                    </button>
                                </h2>
                                <div id="panelsStayOpen-collapse-@categoria.IdCategoria-@tamano.Id" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-heading-@categoria.IdCategoria-@tamano.Id">
                                    <div class="accordion-body-1">
                                        <div id="productGallery">
                                            @foreach (var product in tamano.Medias)
                                            {
                                                <div class="product">
                                                    <h7>@product.TipoMedia?.Name @product.Tamano?.Name @product.Marca?.Name @product.Diseno?.Name @product.Segmento?.Name </h7>
                                                    <br />
                                                    @foreach (var color in product.MediaColores)
                                                    {
                                                        <span class="color-square" style="background-color: @color.Color.RgbColor" title="@color.Color.Name">&ensp;&ensp;</span>
                                                    }
                                                    <div class="image-container">
                                                        <div class="spinner"></div>
                                                        @* <img src="@ViewBag.UlrHost@product.Imagen" class="lazy-image" title="@product.Name" /> *@
                                                        @* <picture>
                                                            <source srcset="@ViewBag.UlrHost@product.Imagen" type="image/webp">
                                                            <img src="@ViewBag.UlrHost@product.Imagen.Replace(".webp",".jpg")" alt="@product.Name">
                                                        </picture> *@
                                                        <img srcset="@ViewBag.UlrHost@product.Imagen.Replace(".webp",".jpg") 480w,
                                                                    @ViewBag.UlrHost@product.Imagen 1024w"
                                                             sizes="(max-width: 600px) 480px, (max-width: 1024px) 500px, 1024px"
                                                             src="@ViewBag.UlrHost@product.Imagen"
                                                             alt="@product.Name">
                                                    </div>
                                                    <div class="new-container">
                                                        <div class="column">
                                                            <button id="codigo" type="button" class="btn btn-dark" style="margin-top:5px">
                                                                Codigo: <span class="badge bg-secondary">@product.Id</span>
                                                            </button>
                                                            <br />
                                                            @if (User.Identity.IsAuthenticated)
                                                            {
                                                                <button type="button" class="btn btn-primary">
                                                                    Existencia <span class="badge bg-secondary">@product?.Existencias?.CantidadProducto</span>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                if (@product.ComprasDetalle.Count == 0)
                                                                {
                                                                    <span class="badge bg-danger">No Disponible. Preguntar:</span>
                                                                    <br />
                                                                    <span class="badge bg-danger">Posible fecha de entrega</span>
                                                                }
                                                                else
                                                                {
                                                                    if (@product?.Existencias?.CantidadProducto > 0)
                                                                    {
                                                                        <span id="EntregaInm" class="badge bg-success">Entrega Inmediata</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-primary">Entrega en 3 días</span>
                                                                    }
                                                                    <br />
                                                                    <input type="hidden" id="@product.Id-hidden" class="valorHidden" name="cartData" value="@product?.ComprasDetalle?.FirstOrDefault()?.CostoUnitario">
                                                                    <span class="badge bg-success">$ Precios:</span>
                                                                    <br />

                                                                    <span id="@product.Id-desc1" class="badge bg-dark">$ Precios:</span> <span class="badge bg-success">6 a 29 Pares</span>
                                                                    <br />

                                                                    <span id="@product.Id-desc2" class="badge bg-dark">$ Precios:</span> <span class="badge bg-success">30 a 99 Pares</span>
                                                                    <br />

                                                                    <span id="@product.Id-desc3" class="badge bg-dark">$ Precios:</span> <span class="badge bg-success">+ 100 Pares</span>
                                                                }
                                                                
                                                            }
                                                            
                                                        </div>
                                                    </div>

                                                    @* <div class="d-flex justify-content-center align-items-center my-3" >
                                                        <input id="@product.Id-cantidad" type="number" class="form-control" style="max-width: 80px; width: 100%; text-align: center;" placeholder="0" min="1" max="999">
                                                    </div>

                                                    <div class="d-flex justify-content-center align-items-center my-3">
                                                        <button id="@product.Id-agregar" type="button" class="btn bg-success text-white" onclick="agregarACarrito(this)">Agregar</button>
                                                    </div>

                                                    <div class="d-flex justify-content-center align-items-center my-3">
                                                        <button id="@product.Id-eliminar" type="button" class="btn bg-success text-white" hidden onclick="eliminarDeCarrito(this)">Eliminar</button>
                                                    </div>
                                                    
                                                    <br /> *@
                                                </div>
                                            }
                                        </div>
                            </div>
                        </div>
                        </div>
                      }
                }
            </div>
        </div>
    </div>
}
</div> 


<!-- Modal Carrito Compras-->
<div class="modal fade" id="carritoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Carrito de Compras</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover color-table">
                        <thead>
                            <tr>
                                <th scope="col">Código</th>
                                <th scope="col">Precio</th>
                                <th scope="col">Cantidad</th>
                                <th scope="col">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="valign-centered">1012</td>
                                <td class="valign-centered">
                                    <span class="price-value">$4.800</span>
                                </td>
                                <!-- Input for quantity in its own td -->
                                <td colspan="2" class="d-flex align-items-center justify-content-center valign-centered">
                                    <input id="1012-cantidad" type="number" class="form-control" style="max-width: 80px; width: 100%; text-align: center;" placeholder="0" min="1" max="999">
                                
                                <!-- Agregar and Eliminar buttons in their own td, one under the other -->
                                
                                    <button id="1012-agregar" type="button" class="btn bg-success text-white btn-xs mb-2" onclick="agregarACarrito(this)">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                    <button id="1012-eliminar" type="button" class="btn bg-success text-white btn-xs mb-2" onclick="eliminarDeCarrito(this)">
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </td>
                                <td class="d-flex align-items-center justify-content-center">
                                    <span class="price-value">$4.800</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script type="text/javascript">

        document.addEventListener("DOMContentLoaded", function () {
            let images = document.querySelectorAll('img');
            let observer = new IntersectionObserver(function (entries, observer) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        let img = entry.target;
                        img.src = img.src;
                        observer.unobserve(img);
                    }
                });
            });

            images.forEach(image => {
                observer.observe(image);
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            const images = document.querySelectorAll('.image-container img');

            images.forEach(function (img) {
                img.addEventListener('load', function () {
                    img.style.display = 'block';
                    img.previousElementSibling.style.display = 'none';
                });
            });
        });

        $(document).ready(function () {
            prices();


            loadSessionCart();


            // Check the existing value from the hidden input
            /*var existingCartData = $('#cart-data').val();

            // Initialize the cart array based on the existing value
            var cart = existingCartData ? JSON.parse(existingCartData) : [];

            // Function to add or update product in cart
            function updateCart(productId, quantity) {
                // Find the product in the cart by productId
                var product = cart.find(item => item.id === productId);

                if (product) {
                    // If product exists in the cart, update the quantity
                    product.quantity += quantity;
                } else {
                    // If product doesn't exist, add it to the cart
                    cart.push({ id: productId, quantity: quantity });
                }

                // Update the hidden input with the serialized cart data
                $('#cart-data').val(JSON.stringify(cart));
            }*/


            //Funcionalidad para abrir y cerrar tabs automaticos
            const urlParams = new URLSearchParams(window.location.search);
            const selectedTab = urlParams.get('selectedTab');
            
            if (selectedTab !== null) {
                var params = selectedTab.split('-');

                

                if (params.length === 2) {
                    const h2Element = document.querySelector('#panelsStayOpen-heading-' + params[0]);
                    const divElement = document.querySelector('#panelsStayOpen-collapse-' + params[0]);

                    const visible = params[1];

                    var buttonElement = h2Element.querySelector('button');

                    if (visible === "false") {
                        buttonElement.classList.add('collapsed');
                        buttonElement.setAttribute('aria-expanded', 'false');

                        divElement.classList.remove('show');
                    }
                    else {
                        buttonElement.classList.remove('collapsed');
                        buttonElement.setAttribute('aria-expanded', 'true');

                        divElement.classList.add('show');
                    }
                }
                else if (params.length === 3)
                {
                    const h2ElementParent = document.querySelector('#panelsStayOpen-heading-' + params[0]);
                    const divElementParent = document.querySelector('#panelsStayOpen-collapse-' + params[0]);

                    const h2ElementChild = document.querySelector('#panelsStayOpen-heading-' + params[0] + '-' + params[1]);
                    const divElementChild = document.querySelector('#panelsStayOpen-collapse-' + params[0] + '-' + params[1]);

                    const visibleChild = params[2];

                    var buttonElementChild = h2ElementChild.querySelector('button');

                    if (visibleChild === "true") {
                        buttonElementChild.classList.add('collapsed');
                        buttonElementChild.setAttribute('aria-expanded', 'false');

                        divElementChild.classList.remove('show');
                    }
                    else {
                        buttonElementChild.classList.remove('collapsed');
                        buttonElementChild.setAttribute('aria-expanded', 'true');

                        divElementChild.classList.add('show');
                    }

                    var buttonElementParent = h2ElementParent.querySelector('button');

                    buttonElementParent.classList.remove('collapsed');
                    buttonElementParent.setAttribute('aria-expanded', 'true');

                    divElementParent.classList.add('show');
                }



                

                

                

                
            }
        });


        function loadTab(tabElement) {
            
            const ariaExpandedValue = tabElement.getAttribute('aria-expanded');
            console.log($('#cart-data').val());
            window.location.href = '@Url.Action("Index", "Inventario")?selectedTab=' + tabElement.id + '-' + ariaExpandedValue;
        }

        function loadSessionCart() {
            // Retrieve sessionStorage data
            const cartData = sessionStorage.getItem("cartData");
            if (cartData) {
                //console.log("Cart data:", JSON.parse(cartData));
                var cartDataParsed = JSON.parse(cartData);
                cartDataParsed.forEach(function (item) {
                    console.log("Product ID: " + item.id + ", Quantity: " + item.quantity);
                    $(`#${item.id}-eliminar`).attr("hidden", false);
                    $(`#${item.id}-cantidad`).addClass("agregado");
                    $(`#${item.id}-cantidad`).val(item.quantity);
                });

            } else {
                console.log("No cart data available");
            }

            if (cartData != null && cartData.length > 0) {
                $(".floating-cart-button").attr("hidden", false);
            } else {
                $(".floating-cart-button").attr("hidden", true);
            }
        }

        function saveSessionCart()
        {
            var cart = [];
            //const hiddenInputs = document.querySelectorAll('.agregado');
            //se debe gestionar busqueda y actualizacion en la variable de sesison
            hiddenInputs.forEach(input => {

                const inputId = input.id;
                // Substraer el sufijo del id antes del carácter "-"
                const suffix = inputId.split('-')[0];

                cart.push({ id: suffix, quantity: input.value });
            });

            if (cartData.length === 0) {
                $(".floating-cart-button").attr("hidden", true);
            } else {
                $(".floating-cart-button").attr("hidden", false);
            }

            sessionStorage.setItem("cartData", JSON.stringify(cart));
        }

        function prices() {
            // Obtener todos los elementos input con la clase valorHidden
            const hiddenInputs = document.querySelectorAll('.valorHidden');
            hiddenInputs.forEach(input => {
                
                if (input.value.trim() !== '') {
                    
                    const inputId = input.id;

                    // Substraer el sufijo del id antes del carácter "-"
                    const suffix = inputId.split('-')[0];

                    // Referenciar el span con id=sufijo-desc2
                    const desc1Span = document.getElementById(`${suffix}-desc1`);
                    const desc2Span = document.getElementById(`${suffix}-desc2`);
                    const desc3Span = document.getElementById(`${suffix}-desc3`);

                    // Si el span existe, setearle el valor del input
                    if (desc1Span) {
                        desc1Span.textContent = formatCurrency(calcularValorFinal(input.value, 1.30));
                    }

                    if (desc2Span) {
                        desc2Span.textContent = formatCurrency(calcularValorFinal(input.value, 1.15));
                    }

                    if (desc3Span) {
                        desc3Span.textContent = formatCurrency(calcularValorFinal(input.value, 1.10));
                    }
                }
            });
        }

        function agregarACarrito(btnAgregar)
        {
            const inputId = btnAgregar.id;
            // Substraer el sufijo del id antes del carácter "-"
            const suffix = inputId.split('-')[0];

            $(`#${suffix}-eliminar`).attr("hidden", false);
            $(`#${suffix}-cantidad`).addClass("agregado");
            saveSessionCart();
            
        }

        function eliminarDeCarrito(btnEliminar) 
        {
            const inputId = btnEliminar.id;
            // Substraer el sufijo del id antes del carácter "-"
            const suffix = inputId.split('-')[0];

            $(`#${suffix}-cantidad`).removeClass("agregado");
            $(`#${suffix}-cantidad`).val('0');
            $(`#${suffix}-eliminar`).attr("hidden", true);
            saveSessionCart();
            
        }

    </script>
}


